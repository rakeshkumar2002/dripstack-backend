# ─────────────────────────────────────────────────────────────────────────────
# DripStack environment. Copy to `.env` and adjust. Every service reads from here.
# In the vertical-slice MVP, all external providers default to LOG/fallback mode,
# so the whole demo runs with NO real API keys.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
# Public base URL the API serves tracked links (action/log/pixel) and preview from.
# Hit by email clients, mail-image proxies and your OIDC provider, so it must be
# publicly reachable. Register {APP_BASE_URL}/api/v1/auth/sso/callback with the IdP.
APP_BASE_URL=http://localhost:4000
# Dashboard origin — used for CORS and for redirects back into the UI
# (/sso/callback, /login, /integrations, /runs/{id}). Must match the dashboard's
# public origin EXACTLY, with no trailing slash. The WORKER needs this too, not
# just the API.
DASHBOARD_URL=http://localhost:3000
# Extra CORS origins (preview/staging), comma separated. Does not affect redirects.
CORS_ALLOWED_ORIGINS=

# --- Postgres (matches docker-compose) ---
POSTGRES_USER=dripstack
POSTGRES_PASSWORD=dripstack
POSTGRES_DB=dripstack
# Read by SQLAlchemy (asyncpg). Host is `postgres` inside docker, `localhost` from
# your machine. A `?schema=public` suffix is tolerated (stripped for asyncpg).
DATABASE_URL=postgresql://dripstack:dripstack@localhost:5432/dripstack

# --- RabbitMQ (queue) ---
# `rabbitmq` inside docker, `localhost` from your machine.
RABBITMQ_USER=dripstack
RABBITMQ_PASSWORD=dripstack
RABBITMQ_URL=amqp://dripstack:dripstack@localhost:5672/

# --- Temporal ---
# `temporal:7233` inside docker, `localhost:7233` from your machine.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=dripstack-sequences

# --- Auth / crypto ---
# CHANGE THESE in any non-local environment.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Secret used to sign tracked action/log URLs (HMAC).
LINK_SIGNING_SECRET=dev-link-signing-secret-change-me

# --- Email (ESP abstraction) ---
# Provider: `log` (default — writes rendered HTML to /dev/emails) | `resend` | `ses`
EMAIL_PROVIDER=log
EMAIL_FROM_DEFAULT="DripStack <alerts@dripstack.dev>"
# Only needed when EMAIL_PROVIDER=resend. NEVER commit a real key here.
RESEND_API_KEY=
# Only needed when EMAIL_PROVIDER=ses. Credentials come from the standard boto3
# chain (env / shared config / IAM role); only the region is required.
AWS_REGION=us-east-1
SES_CONFIGURATION_SET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- AI explainer ---
# Provider: `anthropic` | `fallback` (default — renders the graceful fallback block)
AI_PROVIDER=fallback
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- Channels (deferred; stubbed log mode) ---
SLACK_BOT_TOKEN=
TEAMS_WEBHOOK_URL=

# --- Service ports ---
API_PORT=4000
DASHBOARD_PORT=3000

# --- Deployment ---
# Trusted proxy hops for X-Forwarded-For. Set to the compose bridge subnet (or
# "*" when the API port is only reachable through the proxy) behind Caddy/nginx.
FORWARDED_ALLOW_IPS=127.0.0.1
# Mount /dev/emails even in production. Requires network-level protection.
ENABLE_DEV_EMAIL_PREVIEW=false
# Override where `seed` writes .demo-env / sample-event.json (containers).
DRIPSTACK_DEMO_DIR=
