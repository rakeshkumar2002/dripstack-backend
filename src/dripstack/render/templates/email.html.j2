{#- Outlook-safe email layout (port of render/src/email/SequenceEmail.tsx).
    Code frames put padding on a <td>, not the <pre>; trusted HTML is |safe. -#}
{%- set mono = "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace" -%}
<!doctype html>
<html>
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"></head>
<body style="background-color:#f3f4f6;margin:0;padding:24px 0;color:#1f2328;font-family:ui-sans-serif,system-ui,-apple-system,sans-serif">
<div style="display:none;max-height:0;overflow:hidden">{{ preview }}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;background-color:#ffffff;border:1px solid #d0d7de;border-radius:8px;overflow:hidden">
  <tr><td style="padding:20px 28px;border-bottom:1px solid #d0d7de;font-weight:700;font-size:16px;letter-spacing:0.3px">{{ brand_name }}</td></tr>
  <tr><td style="padding:8px 28px 24px">
  {%- for b in blocks %}
    {%- if b.kind == 'text' %}
      <div style="font-size:15px;line-height:1.6;color:#1f2328">{{ b.html | safe }}</div>
    {%- elif b.kind == 'code' or b.kind == 'log' %}
      {%- if b.kind == 'log' %}
      <div style="margin:16px 0 6px;font-size:12px;color:#656d76;font-weight:600">Log ({{ b.shown }} of {{ b.total }} lines)</div>
      {%- endif %}
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:4px 0"><tr>
        <td style="background-color:#f6f8fa;border:1px solid #d0d7de;border-radius:6px;padding:14px 16px">
          <div style="font-family:{{ mono }};font-size:13px;line-height:1.5;white-space:pre;overflow-x:auto">{{ b.html | safe }}</div>
        </td>
      </tr></table>
      {%- if b.kind == 'log' %}
      <div style="margin:6px 0 0;font-size:13px"><a href="{{ b.view_url }}" style="color:#0969da">View full log →</a></div>
      {%- elif b.truncated and b.view_url %}
      <div style="margin:6px 0 0;font-size:13px"><a href="{{ b.view_url }}" style="color:#0969da">View full content →</a></div>
      {%- endif %}
    {%- elif b.kind == 'ai' %}
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:18px 0 6px"><tr>
        <td style="background-color:#fbf7ff;border:1px solid #d8c5f0;border-radius:8px;padding:16px 18px">
          <div style="margin:0 0 8px;font-size:12px;font-weight:700;color:#8250df">🤖 AI-ASSISTED EXPLANATION</div>
          {%- if b.data %}
          <div style="margin:0 0 10px;font-size:14px;line-height:1.6">{{ b.data.explanation }}</div>
          <div style="margin:0 0 4px;font-size:13px;font-weight:600">Suggested steps</div>
          <ol style="margin:0 0 8px;padding-left:20px;font-size:14px;line-height:1.6">
            {%- for s in b.data.fix_steps %}<li>{{ s }}</li>{%- endfor %}
          </ol>
          <div style="margin:0;font-size:12px;color:#656d76">Confidence: {{ b.data.confidence }} · AI-generated suggestion — verify before acting on live systems.</div>
          {%- else %}
          <div style="margin:0;font-size:14px;line-height:1.6">We couldn't auto-generate an explanation for this error. Our support team has been notified and will follow up.</div>
          {%- endif %}
        </td>
      </tr></table>
    {%- elif b.kind == 'actions' %}
      <table role="presentation" cellpadding="0" cellspacing="0" style="padding:20px 0 4px"><tr>
        {%- for btn in b.buttons %}
        <td style="padding-right:10px">
          <a href="{{ btn.href }}" style="display:inline-block;padding:10px 18px;border-radius:6px;font-size:14px;font-weight:600;text-decoration:none;{% if btn.variant == 'primary' %}color:#ffffff;background-color:#1f883d;border:1px solid #1f883d{% else %}color:#1f2328;background-color:#ffffff;border:1px solid #d0d7de{% endif %}">{{ btn.label }}</a>
        </td>
        {%- endfor %}
      </tr></table>
    {%- endif %}
  {%- endfor %}
  </td></tr>
  <tr><td style="border-top:1px solid #d0d7de;padding:16px 28px;font-size:12px;color:#656d76">Sent by {{ brand_name }} · Technical Lifecycle Communication Platform</td></tr>
</table>
</td></tr></table>
<img src="{{ pixel_url }}" width="1" height="1" alt="" style="display:none">
</body>
</html>
